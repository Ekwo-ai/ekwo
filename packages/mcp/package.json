{
  "name": "@ekwo-ai/mcp",
  "version": "0.2.0",
  "description": "MCP server for Ekwo OS: let an AI assistant keep the books, under the user's own row level security.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "accounting",
    "supabase",
    "postgres",
    "bookkeeping",
    "ekwo"
  ],
  "license": "AGPL-3.0-only",
  "author": "Ekwo AI",
  "homepage": "https://github.com/Ekwo-ai/ekwo-os#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ekwo-ai/ekwo-os.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/Ekwo-ai/ekwo-os/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "ekwo": {
    "schemaMin": "0.2.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "ekwo-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ekwo-ai/core": "^0.2.0",
    "@ekwo-ai/fec": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.58.0",
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "postgres": "^3.4.5"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  }
}
