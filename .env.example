# Ekwo OS — what the CLI reads from the environment.
#
# Copy to `.env` and fill in, or export these in your shell. `.env` is
# git-ignored; `.env.example` is not, and must never hold a real value.
#
# The CLI never writes any of this back to disk. It reads what it needs, uses
# it, and forgets it. `ekwo.json` — the one file it writes — holds the project
# URL, the country and the schema version, and nothing else.
#
# Nothing here is loaded automatically: the CLI reads the process environment.
# Use your own loader, or `set -a; . ./.env; set +a` before running it.

# ---------------------------------------------------------------------------
# The database. Required by every command.
# ---------------------------------------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# It contains your database password. Same as --db-url.
# SUPABASE_DB_URL is read too, so a Supabase CLI setup works unchanged.
EKWO_DB_URL=postgresql://postgres:your-database-password@db.yourprojectref.supabase.co:5432/postgres

# Instead of the full string: the password alone, with --project-ref.
# EKWO_DB_PASSWORD=your-database-password

# ---------------------------------------------------------------------------
# Supabase Auth. Required only to create the first administrator, so only on
# the first `ekwo init` — and not even then if you pass --admin-user-id for an
# account that already exists.
# ---------------------------------------------------------------------------
# Project Settings → API → Project URL.
SUPABASE_URL=https://yourprojectref.supabase.co

# Project Settings → API → service_role key. It can do anything to this
# project: treat it the way you treat a root password. The CLI uses it for one
# HTTP call and never stores it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Optional.
# ---------------------------------------------------------------------------
# Where an opt-in registration is announced. Registering is never required and
# nothing in the software checks whether you did.
# EKWO_REGISTRY_URL=https://api.ekwo.ai/v1/registrations

# Plain output, no escape codes.
# NO_COLOR=1
