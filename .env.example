# Ekwo OS — what the CLI and the MCP server read from the environment.
#
# Copy to `.env` and fill in, or export these in your shell. `.env` is
# git-ignored; `.env.example` is not, and must never hold a real value.
#
# The CLI never writes any of this back to disk. It reads what it needs, uses
# it, and forgets it. `ekwo.json` — the one file it writes — holds the project
# URL, the country and the schema version, and nothing else.
#
# Nothing here is loaded automatically: the CLI reads the process environment.
# Use your own loader, or `set -a; . ./.env; set +a` before running it.

# ---------------------------------------------------------------------------
# The database. Required by every command.
# ---------------------------------------------------------------------------
# Supabase dashboard → Connect → Session pooler. It contains your database
# password. Same as --db-url. SUPABASE_DB_URL is read too, so a Supabase CLI
# setup works unchanged.
#
# Take the pooler string, not the direct one: db.<ref>.supabase.co is IPv6-only
# on any recent project, so from an IPv4 network it never connects at all. The
# prefix before the region — aws-0 or aws-1 — is not derivable from the region;
# copy the hostname the dashboard prints.
EKWO_DB_URL=postgresql://postgres.yourprojectref:your-database-password@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

# Instead of the full string: the password alone, with --project-ref.
# EKWO_DB_PASSWORD=your-database-password

# ---------------------------------------------------------------------------
# Supabase Auth. Required only to create the first administrator, so only on
# the first `ekwo init` — and not even then if you pass --admin-user-id for an
# account that already exists.
# ---------------------------------------------------------------------------
# Project Settings → API → Project URL.
SUPABASE_URL=https://yourprojectref.supabase.co

# Project Settings → API → service_role key. It can do anything to this
# project: treat it the way you treat a root password. The CLI uses it for one
# HTTP call and never stores it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# The MCP server (`npx @ekwo-ai/mcp`). Nothing here is shared with the CLI
# except SUPABASE_URL: this server acts as a USER, never as the project.
# ---------------------------------------------------------------------------
# Project Settings → API → anon (publishable) key. NOT the service_role key
# above: that one bypasses every row level security policy, and the server
# refuses to start with it.
# SUPABASE_ANON_KEY=your-anon-key

# The person the assistant acts as. Everything it can read or write is what
# this user can read or write.
# EKWO_EMAIL=you@example.com
# EKWO_PASSWORD=your-password

# Or a session you already hold, instead of the two above.
# EKWO_ACCESS_TOKEN=your-access-token

# Self-hosted, with no PostgREST in front of the database. EKWO_DB_URL above
# is reused, and the user to act for is then required: a database connection
# is nobody, and row level security would be bypassed rather than satisfied.
# EKWO_ACT_AS_USER_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Optional.
# ---------------------------------------------------------------------------
# Where an opt-in registration is announced. Registering is never required and
# nothing in the software checks whether you did.
# EKWO_REGISTRY_URL=https://api.ekwo.ai/v1/registrations

# Plain output, no escape codes.
# NO_COLOR=1
